// Visualise your data
var pop_result = ee.FeatureCollection('projects/ee-jitzjude27/assets/pop_changePerEcoregion')
Map.addLayer(pop_result)
print (pop_result.sort('mean').limit(10))
var pop_highestchange = (pop_result.sort('mean', false).first())
Map.addLayer(ee.Feature(pop_highestchange),{color : "red"}, "Highest change in population")

var nl_result = ee.FeatureCollection('projects/ee-jitzjude27/assets/nl_changePerEcoregion')
Map.addLayer(nl_result)
print(nl_result.limit(5))
var nl_highestchange = (nl_result.sort('mean', false).first())
Map.addLayer(ee.Feature(nl_highestchange),{color : "red"}, "Highest change in Night Light")

// Visualise result

var empty = ee.Image().byte() // make an empty image
var palette = ['green','yellow', 'orange', 'red'];
var popChangePerEcoregion = empty.paint({
  featureCollection: pop_result,
  color:'mean'
})

Map.addLayer(popChangePerEcoregion, {max:112, palette: palette}, 'popChange_result')

var empty2 = ee.Image().byte() // make an empty image
var palette = ['green','yellow', 'orange', 'red'];
var nlChangePerEcoregion = empty2.paint({
  featureCollection: nl_result,
  color:'mean'
})

Map.addLayer(nlChangePerEcoregion, {max:112, palette: palette}, 'nlChange_result')
