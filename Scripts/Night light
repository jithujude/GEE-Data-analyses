// Night light in global coastlines
// Population

var Popln = ee.ImageCollection("CIESIN/GPWv411/GPW_Population_Count")
print (Popln)

//import two images for start and end

var population_2000 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2000_30_sec')
var population_2015 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2015_30_sec')
print (population_2000)

var population_vis 
//{  'max': 1000.0,
//'palette': [
//  'ffffe7',
//  '86a192',
//  '509791',
//   '307296',
//   '2c4484',
  //'000066'
// ], 'min': 0.0 };
Map.addLayer(population_2000)//,population_vis, 'population_count_2000');

Map.addLayer(population_2015)//, population_vis, 'population_count_2015');

// Vector data
var grid = ee.FeatureCollection('users/murrnick/mb5370/worldgrid_5deg'); // 5 degree grid
Map.addLayer(grid,{color: 'white'},'grid', false , 0.4)
print(grid.first())


// Nightlights


var Night_light = ee.ImageCollection("NOAA/DMSP-OLS/NIGHTTIME_LIGHTS")

print(Night_light)

// get two images for start and end

var nl_2000 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F142000').select(['avg_vis'], ['nightlight']) //select and rename


//Map.addLayer( nl_2000,
//{ min: 0, max: 63,
//palette: 
//[ '000000', // Black
 //   '1a237e', // Dark blue
//    '4a148c', // Purple
//    '880e4f', // Dark magenta
//   'd32f2f', // Red
//  'f57c00', // Orange
//   'ffeb3b', // Yellow
//    'ffffff'  // White
//  ]})

print ('nightlight 2000 processed', nl_2000)

var nl_2013 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F182013').select(['avg_vis'], ['nightlight'])

 //Map.addLayer( nl_2013,{
//  min: 0,
 // max: 63,
 // palette: [
 //   '22162b',
//    '451f55',
//    '724e91',
//    'e54f6d',
//    'f8c630',
//  ]})
print ('nightlight 2013 processed', nl_2013)

// // // Coast Line
var coast = ee.FeatureCollection('projects/UQ_intertidal/dataMasks/naturalEarthCoastline_v1')
Map.addLayer(coast, {color:'white'}, 'coast')

// // Coast grids
var coastgrids = grid
.filter(ee.Filter.bounds(coast))
Map.addLayer(coastgrids,{color:'red'},'coastgrid')

var nl_change = nl_2013.subtract(nl_2000)
Map.addLayer(nl_change, {min:-5,max:20, palette:['darkblue', 'black' , 'yellow']})

// // summarise pixel numbers per regions

// Filter ecoregions to bounds

//var keralacoast_ecoregions = grid
//.filter(ee.Filter.bounds(coast))
//.filter(ee.Filter.bounds(geometry)) // let's limit it for testing
//Map.addLayer(Keralacoast_ecoregions, {color:'firebrick'}, 'Kerala')

//print(Keralacoast_ecoregions)

// // Global change
// adding population change (2000-2015)
var pop_change = population_2015
  .subtract(population_2000)
  .clip(coastgrids)
Map.addLayer (pop_change, {palette:  ['red', 'black', 'lime'], min: -500, max: 500}, 'pop_change', true, 0.9)

// adding Night light change (2000-2013)
var nl_change = nl_2013
  .subtract(nl_2000)
  .clip(coastgrids)
Map.addLayer (nl_change, {palette:  ['red', 'black', 'lime'], min: -50, max: 50}, 'nl_change', true, 0.9)

// average change in population in ecoregion
var pop_changePerEcoregion = pop_change.reduceRegions({
  collection: coastgrids, 
  reducer: ee.Reducer.mean(), 
  scale: 1000, // note computing at a larger scale for speed
});
print('popln change per ecoregion', pop_changePerEcoregion.first()) // look at properties of the first one


// average change in nightlights in ecoregion
var nl_changePerEcoregion = nl_change.reduceRegions({
  collection: coastgrids, 
  reducer: ee.Reducer.mean(), 
  scale: 1000, // note computing at a larger scale for speed
});
print('nl change per ecoregion', nl_changePerEcoregion.first()) // look at properties of the first one


