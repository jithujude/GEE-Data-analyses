// Allen coral atlas - maximum coral reef acccessible 

// Global Variables
var distance = 800 // metres we are allowed to snorkel from the station

Map.setOptions('SATELLITE')
// Field Stations
// 9 stations from GBR and 1 from New Caledonia

var field_stations = ee.FeatureCollection([Heron, Orpheus, Hamilton, Lizard, Daydream, LadyElliot, Green, Lowisles, Onetree, IlotMaitre])
print (field_stations)
Map.addLayer(field_stations,{color : 'yellow'},'Field stations')
 // Data processing
var aca = ee.Image("ACA/reef_habitat/v2_0").select("benthic")

var coral = aca
.eq(15) //returns 1 if true
Map.addLayer(coral,{palette:['red']},'Coral only')

// add buffer to the stations  
var station_buffer = ee.Feature(field_stations.first()).buffer(800)
Map.addLayer(station_buffer)

var buffer = function(feature) { 
  //aplies buffer to a feature when given a value (num)
  var buffered = feature.buffer(800)
  return buffered ;
} 
var out = field_stations.map(buffer)

print(out,'out')
Map.addLayer (out,{colour:'yellow'},'buffered')

var area_pixels = ee.Image(ee.Image.pixelArea()).updateMask(coral)

var coral_area = area_pixels.reduceRegions({
  reducer: ee.Reducer.sum(),
  collection: out, //buffered collection
  scale: 5
})

print(coral_area, 'coral area')
Map.addLayer(coral_area,{ color:'blue'}, 'coral area')
//sorting to find highest coral area under selected stations
var high_coral = coral_area.sort('sum',false).first()
print (high_coral, 'highest coral area site')
Map.addLayer(ee.Feature(high_coral),{ color:'pink'}, 'highest coral area')
//sorting to find lowest coral area  under selected stations
var low_coral = coral_area.sort('sum',true).first()
print (low_coral, 'lowest coral area site')
Map.addLayer(ee.Feature(low_coral),{ color:'green'}, 'lowest coral area')

// clean

var cleaner = function (feature) {
  //custom function to clean my output 
  var clean = {
    station_name:feature.get('field Station'),
    area_m2: ee.Number(feature.get('sum')),
    area_km2: ee.Number(feature.get('sum')).divide(1000*1000),
    analyst: 'jithu'
  }
  return feature.set(clean);
}

var cleaned_result = coral_area.map(cleaner).sort('area_km2',false)
print(cleaned_result,'cleaned result')

// ****************************/
// Package up results and export
// ****************************/

Export.table.toDrive({
  collection: cleaned_result, //FYI - type: featureCollection
  description: 'exportToDrive',
  fileNamePrefix: 'research_stations',
  fileFormat:'CSV'
})

var exportImage = aca.clip (IlotMaitre)
Map.addLayer(exportImage)

Export.image.toDrive({
  image: exportImage, //FYI - type: Image
  description: 'exportImageToDrive',
  fileNamePrefix: 'aca_Ilotmaitre',
  fileFormat:'GeoTIFF',
  scale:5
})

